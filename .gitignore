# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment / secrets ────────────────────────────────────
# Never commit real credentials. .env.example is the documented template
# and is deliberately kept.
.env
.env.*
!.env.example

# ── Build output ─────────────────────────────────────────────
dist/
dist-ssr/
build/
.vite/
*.local

# ── Uploaded files ───────────────────────────────────────────
# Submission attachments are user data, not source.
Backend/uploads/*
!Backend/uploads/.gitkeep

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Tooling caches / coverage ────────────────────────────────
.eslintcache
coverage/
*.tsbuildinfo
.npm
.cache/
.temp/
.tmp/

# ── Editors & IDEs ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── OS cruft ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/



