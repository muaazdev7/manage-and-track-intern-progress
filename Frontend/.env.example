# Copy this file to .env. Never commit .env.
#
# Backend origin — no trailing slash and no /api suffix; the app appends /api
# itself (see src/api/config.js).
#
#   local        http://localhost:5000
#   production   https://your-api-host.example.com
#
# On Vercel, set VITE_API_URL under Settings → Environment Variables instead
# of editing this file. Vite inlines it at build time, so changing it there
# requires a redeploy.
VITE_API_URL=http://localhost:5000
