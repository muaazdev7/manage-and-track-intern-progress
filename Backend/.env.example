# Copy this file to .env and fill in the values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# Database — MongoDB Atlas connection string.
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/interntrack?retryWrites=true&w=majority
# URL-encode any of @ : / ? # [ ] % in the password (@ becomes %40).
MONGO_URI=

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# CORS / cookies — Vite dev server origin
CLIENT_URL=http://localhost:5173

# Uploads (PROJECT_PLAN.md §10)
MAX_FILE_SIZE=5242880
MAX_FILES_PER_SUBMISSION=5
